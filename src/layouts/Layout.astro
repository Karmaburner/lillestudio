---
import '../styles/global.css'
import Lightbox from '../components/Lightbox.astro'

interface Props {
  title?: string
}

const { title = 'Lille Studio' } = Astro.props
const nav = [
  { href: '/', label: 'Forside' },
  { href: '/galleri', label: 'Galleri' },
  { href: '/priser', label: 'Priser' },
  { href: '/om-meg', label: 'Om meg' },
  { href: '/kontakt', label: 'Kontakt' },
]
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Lille Studio — fotograf Audun Haugen. Portrett, familie, konfirmant og bryllupsfoto." />
    <title>{title} | Lille Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="sticky top-0 z-50 bg-stone-50/95 backdrop-blur border-b border-stone-200">
      <nav class="max-w-5xl mx-auto px-6 h-44 flex items-center justify-between">
        <a href="/">
          <img src="/images/Logo_Milevasslien.png" alt="Lille Studio" class="h-40 w-auto" />
        </a>
        <ul class="hidden md:flex gap-12 text-stone-500" style="font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; letter-spacing: 0.08em;">
          {nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={`relative cursor-pointer group inline-block py-1 transition-colors duration-200 hover:text-stone-900
                  ${currentPath === href ? 'text-stone-900' : ''}`}
              >
                {label}
                <span class={`absolute bottom-0 left-0 h-px bg-stone-800 transition-all duration-300
                  ${currentPath === href ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
              </a>
            </li>
          ))}
        </ul>
        <button id="menu-btn" class="md:hidden p-2 text-stone-700" aria-label="Meny">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-stone-50">
        <ul class="flex flex-col px-6 py-4 gap-4 text-sm font-medium text-stone-600">
          {nav.map(({ href, label }) => (
            <li>
              <a href={href} class="hover:text-stone-900 transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <Lightbox />

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-stone-100">
      <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col md:flex-row justify-between gap-6 text-sm text-stone-500">
        <div>
          <p class="font-semibold text-stone-700 mb-1">Lille Studio</p>
          <p>Fotograf Audun Haugen</p>
        </div>
        <div class="flex flex-col gap-1">
          <a href="tel:99039160" class="hover:text-stone-700 transition-colors">📞 99 03 91 60</a>
          <a href="mailto:audun@lillestudio.no" class="hover:text-stone-700 transition-colors">✉️ audun@lillestudio.no</a>
          <a href="https://www.facebook.com/fotografaudunhaugen" target="_blank" rel="noopener" class="hover:text-stone-700 transition-colors">📘 Facebook</a>
        </div>
        <div class="self-end text-xs text-right space-y-1">
          <p>© {new Date().getFullYear()} Lille Studio</p>
          <p>Laget av <a href="https://lilitlabs.com" target="_blank" rel="noopener" class="hover:text-stone-700 transition-colors underline underline-offset-2">Lilit Labs</a></p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn')
      const menu = document.getElementById('mobile-menu')
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'))
    </script>
  </body>
</html>
