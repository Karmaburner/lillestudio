---
import { allImages } from '../data/images'
import { bilde } from '../lib/bilde'

// Bildene sendes til klienten med ferdig utregnet src og srcset, slik at
// lightboxen slipper å laste originalen på flere tusen piksler på mobil.
const bilder = allImages.map(b => ({ ...b, ...bilde(b.src) }))
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lb-category"
  aria-hidden="true"
>

  <!-- Lukk -->
  <button
    id="lb-close"
    type="button"
    aria-label="Lukk bildevisning"
    class="absolute top-4 right-4 text-white/60 hover:text-white text-3xl font-light z-10 cursor-pointer transition-colors w-10 h-10 flex items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
  >✕</button>

  <!-- Pil venstre -->
  <button
    id="lb-prev"
    type="button"
    aria-label="Forrige bilde"
    class="absolute left-1 md:left-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-4xl md:text-5xl z-10 cursor-pointer transition-colors select-none px-2 py-4 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
  >‹</button>

  <!-- Innhold: stacked på mobil, side-by-side på desktop -->
  <div class="flex flex-col md:flex-row w-full max-w-6xl mx-auto px-8 md:px-20 py-14 md:py-16 gap-4 md:gap-8 items-center justify-center h-full overflow-y-auto">

    <!-- Bilde -->
    <div class="flex-1 flex items-center justify-center w-full">
      <img id="lb-img" src="" alt="" class="max-h-[55vh] md:max-h-[75vh] max-w-full object-contain rounded-sm shadow-2xl" />
    </div>

    <!-- Info panel -->
    <div class="md:w-56 flex flex-col gap-3 text-white shrink-0 w-full">
      <p id="lb-category" class="text-xl md:text-2xl font-semibold tracking-wide" style="font-family: 'Cormorant Garamond', serif; letter-spacing: 0.05em;"></p>
      <p id="lb-comment" class="text-stone-300 text-sm leading-relaxed italic"></p>
      <div id="lb-tags" class="flex flex-wrap gap-2"></div>
      <p id="lb-teller" class="text-xs text-stone-400" role="status" aria-live="polite"></p>
    </div>

  </div>

  <!-- Pil høyre -->
  <button
    id="lb-next"
    type="button"
    aria-label="Neste bilde"
    class="absolute right-1 md:right-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-4xl md:text-5xl z-10 cursor-pointer transition-colors select-none px-2 py-4 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
  >›</button>

</div>

<script define:vars={{ bilder }}>
  const lb = document.getElementById('lightbox')
  const lbImg = document.getElementById('lb-img')
  const lbCategory = document.getElementById('lb-category')
  const lbComment = document.getElementById('lb-comment')
  const lbTags = document.getElementById('lb-tags')
  const lbTeller = document.getElementById('lb-teller')
  const lbClose = document.getElementById('lb-close')
  const lbPrev = document.getElementById('lb-prev')
  const lbNext = document.getElementById('lb-next')

  const fokuserbare = [lbClose, lbPrev, lbNext]
  let sequence = [...bilder].sort(() => Math.random() - 0.5)
  let currentIndex = 0
  // Hvem som hadde fokus for lightboxen apnet, slik at fokus kan gis tilbake ved lukking.
  let forrigeFokus = null

  function openLightbox(imageId) {
    const idx = sequence.findIndex(img => img.id === imageId)
    if (idx !== -1) currentIndex = idx
    else {
      const img = bilder.find(i => i.id === imageId)
      if (!img) return
      sequence.unshift(img)
      currentIndex = 0
    }
    forrigeFokus = document.activeElement
    showCurrent()
    lb.classList.remove('hidden')
    lb.classList.add('flex')
    lb.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
    lbClose.focus()
  }

  function closeLightbox() {
    lb.classList.add('hidden')
    lb.classList.remove('flex')
    lb.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    if (forrigeFokus && typeof forrigeFokus.focus === 'function') forrigeFokus.focus()
    forrigeFokus = null
  }

  function erApen() {
    return !lb.classList.contains('hidden')
  }

  function showCurrent() {
    const img = sequence[currentIndex]
    if (!img) return
    lbImg.src = img.src
    if (img.srcset) lbImg.srcset = img.srcset
    lbImg.sizes = '(min-width: 768px) 70vw, 100vw'
    lbImg.alt = img.alt
    lbCategory.textContent = img.categoryLabel
    lbComment.textContent = img.comment
    lbTeller.textContent = `Bilde ${currentIndex + 1} av ${sequence.length}`
    lbTags.innerHTML = img.tags
      .map(tag => `<span class="text-xs text-stone-400 bg-stone-800 px-2 py-1 rounded-full">${tag}</span>`)
      .join('')
  }

  function gaTil(retning) {
    currentIndex = (currentIndex + retning + sequence.length) % sequence.length
    showCurrent()
  }

  lbClose.addEventListener('click', closeLightbox)
  lbPrev.addEventListener('click', () => gaTil(-1))
  lbNext.addEventListener('click', () => gaTil(1))
  lb.addEventListener('click', e => {
    if (e.target === lb) closeLightbox()
  })

  document.addEventListener('keydown', e => {
    if (!erApen()) return
    if (e.key === 'Escape') closeLightbox()
    if (e.key === 'ArrowLeft') gaTil(-1)
    if (e.key === 'ArrowRight') gaTil(1)
    if (e.key === 'Tab') {
      // Hold fokus inne i dialogen sa lenge den er apen.
      const indeks = fokuserbare.indexOf(document.activeElement)
      e.preventDefault()
      const neste = e.shiftKey ? indeks - 1 : indeks + 1
      fokuserbare[(neste + fokuserbare.length) % fokuserbare.length].focus()
    }
  })

  // Touch swipe support
  let touchStartX = 0
  lb.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX }, { passive: true })
  lb.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX
    if (Math.abs(diff) > 50) gaTil(diff > 0 ? 1 : -1)
  })

  window.openLightbox = openLightbox
</script>
