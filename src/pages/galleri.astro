---
import Layout from '../layouts/Layout.astro'
import { allImages, kategorier } from '../data/images'
import { bilde } from '../lib/bilde'

// Galleriet hadde tidligere sin egen hardkodede liste. Nå er images.ts eneste kilde,
// så lightboxen og galleriet aldri kan komme i utakt.
const bilder = allImages.map(b => ({ ...b, ...bilde(b.src) }))
---

<Layout title="Galleri" description="Se bilder fra fotograferinger i Ringerike og Hønefoss. Barn, familie, konfirmant, bryllup, portrett og bedriftsfoto av Audun Haugen.">
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-16">
    <h1 class="font-bold text-center mb-3">Galleri</h1>
    <p class="text-stone-500 text-center mb-10">Et utvalg av arbeidene mine</p>

    <!-- Filter knapper -->
    <div class="flex flex-wrap gap-2 md:gap-3 justify-center mb-8 md:mb-12" id="filter-btns" role="group" aria-label="Filtrer galleriet">
      {kategorier.map(({ id, label }) => (
        <button
          type="button"
          data-filter={id}
          aria-pressed={id === 'alle' ? 'true' : 'false'}
          class={`px-5 py-2 rounded-full text-sm font-medium border transition-colors cursor-pointer
            ${id === 'alle' ? 'bg-stone-800 text-white border-stone-800' : 'bg-white text-stone-600 border-stone-300 hover:border-stone-600'}`}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Bildegrid -->
    <div class="columns-2 md:columns-3 gap-4 space-y-4" id="gallery-grid">
      {bilder.map(({ id, src, srcset, width, height, alt, category, categoryLabel }) => (
        <button
          type="button"
          data-bilde={id}
          data-category={category}
          aria-label={`Åpne bildet: ${alt}`}
          class="block w-full break-inside-avoid overflow-hidden rounded-lg gallery-item cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-700"
        >
          <img
            src={src}
            srcset={srcset}
            sizes="(min-width: 768px) 33vw, 50vw"
            width={width}
            height={height}
            alt={alt}
            class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500 rounded-lg"
            loading="lazy"
            decoding="async"
          />
          <span class="sr-only">{categoryLabel}</span>
        </button>
      ))}
    </div>
  </section>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#filter-btns button')
  const items = document.querySelectorAll<HTMLElement>('.gallery-item')

  items.forEach(item => {
    item.addEventListener('click', () => {
      const id = item.dataset.bilde
      if (id) (window as any).openLightbox(id)
    })
  })

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!

      btns.forEach(b => {
        b.classList.remove('bg-stone-800', 'text-white', 'border-stone-800')
        b.classList.add('bg-white', 'text-stone-600', 'border-stone-300')
        b.setAttribute('aria-pressed', 'false')
      })
      btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800')
      btn.classList.remove('bg-white', 'text-stone-600', 'border-stone-300')
      btn.setAttribute('aria-pressed', 'true')

      items.forEach(item => {
        const vis = filter === 'alle' || item.dataset.category === filter
        item.style.display = vis ? '' : 'none'
      })
    })
  })
</script>
