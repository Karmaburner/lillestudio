---
import Layout from '../layouts/Layout.astro'
import { allImages } from '../data/images'
const base = import.meta.env.BASE_URL

const images = [
  { id: 'konfirmanten', src: `${base}images/konfirmanten.webp`, alt: 'Konfirmantfoto', category: 'konfirmant' },
  { id: 'familie', src: `${base}images/familie.webp`, alt: 'Familiefoto', category: 'barn-familie' },
  { id: 'babykrybbe', src: `${base}images/babykrybbe.webp`, alt: 'Baby i krybbe', category: 'barn-familie' },
  { id: 'barn-svarthvitt', src: `${base}images/barn1_svarthvitt.webp`, alt: 'Barn svart-hvitt', category: 'barn-familie' },
  { id: 'barnmednavneskilt', src: `${base}images/barnmednavneskilt.webp`, alt: 'Barn med navneskilt', category: 'barn-familie' },
  { id: 'barn-skateboard', src: `${base}images/barn_skateboard.webp`, alt: 'Barn på skateboard', category: 'barn-familie' },
  { id: 'sovebaby', src: `${base}images/sovebaby_svarthvit.webp`, alt: 'Sovende baby', category: 'barn-familie' },
  { id: 'alternativ-barnebilde', src: `${base}images/alternativ_barnebilde.webp`, alt: 'Barnefoto', category: 'barn-familie' },
  { id: 'b1', src: `${base}images/b1.webp`, alt: 'Barnefoto', category: 'barn-familie' },
  { id: 'parbilder', src: `${base}images/parbilder.webp`, alt: 'Parbilde', category: 'bryllup' },
  { id: 'parbilde-farger', src: `${base}images/parbilde_farger.webp`, alt: 'Parbilde farger', category: 'bryllup' },
  { id: 'svarthvit', src: `${base}images/svarthvit.webp`, alt: 'Portrett svart-hvitt', category: 'portrett' },
  { id: 'alternativbaby', src: `${base}images/alternativbaby.webp`, alt: 'Babyfoto', category: 'barn-familie' },
  { id: 'babygitar', src: `${base}images/babygitar.webp`, alt: 'Baby med gitar', category: 'barn-familie' },
  { id: 'babyleonore', src: `${base}images/babyleonore.webp`, alt: 'Baby Leonore', category: 'barn-familie' },
  { id: 'harley', src: `${base}images/harley.webp`, alt: 'Harley Davidson', category: 'bedrift' },
  { id: 'harley2', src: `${base}images/harley2.webp`, alt: 'Harley Davidson 2', category: 'bedrift' },
]

const categories = [
  { id: 'alle', label: 'Alle' },
  { id: 'barn-familie', label: 'Barn & familie' },
  { id: 'konfirmant', label: 'Konfirmant' },
  { id: 'bryllup', label: 'Bryllupsfoto' },
  { id: 'portrett', label: 'Portrett' },
  { id: 'bedrift', label: 'Bedrift & reklame' },
]
---

<Layout title="Galleri" description="Se bilder fra fotograferinger i Ringerike og Hønefoss — barn, familie, konfirmant, bryllup, portrett og bedriftsfoto av Audun Haugen.">
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-16">
    <h1 class="font-bold text-center mb-3">Galleri</h1>
    <p class="text-stone-500 text-center mb-10">Et utvalg av arbeidene mine</p>

    <!-- Filter knapper -->
    <div class="flex flex-wrap gap-2 md:gap-3 justify-center mb-8 md:mb-12" id="filter-btns">
      {categories.map(({ id, label }) => (
        <button
          data-filter={id}
          class={`px-5 py-2 rounded-full text-sm font-medium border transition-colors cursor-pointer
            ${id === 'alle' ? 'bg-stone-800 text-white border-stone-800' : 'bg-white text-stone-600 border-stone-300 hover:border-stone-600'}`}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Bildegrid -->
    <div class="columns-2 md:columns-3 gap-4 space-y-4" id="gallery-grid">
      {images.map(({ id, src, alt, category }) => (
        <div data-category={category} class="break-inside-avoid overflow-hidden rounded-lg gallery-item cursor-pointer" onclick={`window.openLightbox('${id}')`}>
          <img
            src={src}
            alt={alt}
            class="w-full object-cover hover:scale-105 transition-transform duration-500 rounded-lg"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#filter-btns button')
  const items = document.querySelectorAll<HTMLElement>('.gallery-item')

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!

      btns.forEach(b => {
        b.classList.remove('bg-stone-800', 'text-white', 'border-stone-800')
        b.classList.add('bg-white', 'text-stone-600', 'border-stone-300')
      })
      btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800')
      btn.classList.remove('bg-white', 'text-stone-600', 'border-stone-300')

      items.forEach(item => {
        if (filter === 'alle' || item.dataset.category === filter) {
          item.style.display = ''
        } else {
          item.style.display = 'none'
        }
      })
    })
  })
</script>
