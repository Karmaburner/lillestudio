---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Kontakt" description="Ta kontakt med fotograf Audun Haugen i Hønefoss. Book fotografering i Ringerike og omegn — ring, send e-post eller fyll ut skjemaet.">
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-16">
    <h1 class="text-4xl font-bold text-center mb-3">Kontakt</h1>
    <p class="text-stone-500 text-center mb-10 md:mb-14">Ta gjerne kontakt for prisforespørsel, timebestilling eller spørsmål.</p>

    <div class="grid md:grid-cols-2 gap-8 md:gap-12">
      <!-- Kontaktinfo -->
      <div class="space-y-6">
        <h2 class="text-xl font-semibold text-stone-800">Kontaktinformasjon</h2>

        <div class="space-y-4">
          <a href="tel:99039160" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11 19.79 19.79 0 0 1 1.62 2.38a2 2 0 0 1 1.79-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.46-.46a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">Telefon</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">99 03 91 60</p>
            </div>
          </a>

          <a href="mailto:audun@lillestudio.no" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">E-post</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">audun@lillestudio.no</p>
            </div>
          </a>

          <a href="https://www.facebook.com/fotografaudunhaugen" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">Facebook</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">Fotograf Audun Haugen</p>
            </div>
          </a>

          <a href="https://www.instagram.com/I_am_audun" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">Instagram</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">@I_am_audun</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Kontaktskjema -->
      <div>
        <h2 class="text-xl font-semibold text-stone-800 mb-6">Send en melding</h2>
        <form class="space-y-4" id="contact-form" action="https://formspree.io/audun@lillestudio.no" method="POST">
          <div>
            <label for="name" class="block text-sm font-medium text-stone-600 mb-1">Navn</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
              placeholder="Ditt navn"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-stone-600 mb-1">E-post</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
              placeholder="din@epost.no"
            />
          </div>
          <div>
            <label for="type" class="block text-sm font-medium text-stone-600 mb-1">Type fotografering</label>
            <select
              id="type"
              name="type"
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
            >
              <option value="">Velg kategori</option>
              <option>Barn & familie</option>
              <option>Konfirmant</option>
              <option>Bryllupsfoto</option>
              <option>Portrett</option>
              <option>Baby & nyfødt</option>
              <option>Bedrift & reklame</option>
              <option>Annet</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-stone-600 mb-1">Melding</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800 resize-none"
              placeholder="Fortell litt om hva du ønsker..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 text-white py-3 rounded-full font-medium hover:opacity-85 transition-opacity" style="background-color: var(--accent)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Send melding
          </button>
          <p id="form-status" class="text-center text-sm text-stone-500 hidden"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

