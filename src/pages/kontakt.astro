---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Kontakt">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-center mb-3">Kontakt</h1>
    <p class="text-stone-500 text-center mb-14">Ta gjerne kontakt for prisforespørsel, timebestilling eller spørsmål.</p>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Kontaktinfo -->
      <div class="space-y-6">
        <h2 class="text-xl font-semibold text-stone-800">Kontaktinformasjon</h2>

        <div class="space-y-4">
          <a href="tel:99039160" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="text-2xl">📞</span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">Telefon</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">99 03 91 60</p>
            </div>
          </a>

          <a href="mailto:audun@lillestudio.no" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="text-2xl">✉️</span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">E-post</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">audun@lillestudio.no</p>
            </div>
          </a>

          <a href="https://www.facebook.com/fotografaudunhaugen" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-stone-200 hover:border-stone-400 transition-colors group">
            <span class="text-2xl">📘</span>
            <div>
              <p class="text-xs text-stone-400 uppercase tracking-wide">Facebook</p>
              <p class="font-medium text-stone-800 group-hover:text-stone-600">Fotograf Audun Haugen</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Kontaktskjema -->
      <div>
        <h2 class="text-xl font-semibold text-stone-800 mb-6">Send en melding</h2>
        <form class="space-y-4" id="contact-form" action="https://formspree.io/audun@lillestudio.no" method="POST">
          <div>
            <label for="name" class="block text-sm font-medium text-stone-600 mb-1">Navn</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
              placeholder="Ditt navn"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-stone-600 mb-1">E-post</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
              placeholder="din@epost.no"
            />
          </div>
          <div>
            <label for="type" class="block text-sm font-medium text-stone-600 mb-1">Type fotografering</label>
            <select
              id="type"
              name="type"
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800"
            >
              <option value="">Velg kategori</option>
              <option>Barn & familie</option>
              <option>Konfirmant</option>
              <option>Bryllupsfoto</option>
              <option>Portrett</option>
              <option>Baby & nyfødt</option>
              <option>Bedrift & reklame</option>
              <option>Annet</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-stone-600 mb-1">Melding</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:outline-none focus:ring-2 focus:ring-stone-400 bg-white text-stone-800 resize-none"
              placeholder="Fortell litt om hva du ønsker..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full text-white py-3 rounded-full font-medium hover:opacity-85 transition-opacity" style="background-color: var(--accent)"
          >
            Send melding
          </button>
          <p id="form-status" class="text-center text-sm text-stone-500 hidden"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

