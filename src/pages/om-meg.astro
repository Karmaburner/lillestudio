---
import Layout from '../layouts/Layout.astro'
const base = import.meta.env.BASE_URL
---

<Layout title="Om meg" description="Audun Milevasslien Haugen er fotograf i Hønefoss med hjerte for naturlige øyeblikk. Morsom, blid og trygg for alle aldre — hele Ringerike og omegn.">
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-16">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <img
          src={`${base}images/Fotograf_Audun_Milevasslien_portrett_Om_Meg.webp`}
          alt="Fotograf Audun Haugen"
          class="w-full rounded-2xl object-cover aspect-[3/4]"
        />
      </div>
      <div>
        <h1 class="text-4xl font-bold mb-6">Hei, jeg er Audun</h1>
        <div class="space-y-4 text-stone-600 leading-relaxed">
          <p>
            Jeg er en lidenskapelig fotograf med spesialitet innen portrett, familie og livsstilsfotografering.
          </p>
          <p>
            For meg handler fotografering om å fange ekte øyeblikk. Ikke iscenesatte positurer, men naturlig glede og kjærlighet slik den er. Enten det er et nyfødt barn, en konfirmant eller et brudepar, jobber jeg for å skape bilder som varer livet ut.
          </p>
          <p>
            Jeg er kjent for å være morsom og blid på jobb, noe som gjør at selv de minste barna føler seg trygge foran kameraet.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-2 gap-3 text-sm">
          <a href="tel:99039160" class="flex items-center gap-2 px-4 py-3 bg-stone-100 rounded-xl text-stone-700 hover:bg-stone-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11 19.79 19.79 0 0 1 1.62 2.38a2 2 0 0 1 1.79-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.46-.46a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            99 03 91 60
          </a>
          <a href="mailto:audun@lillestudio.no" class="flex items-center gap-2 px-4 py-3 bg-stone-100 rounded-xl text-stone-700 hover:bg-stone-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            E-post
          </a>
          <a href="https://www.facebook.com/fotografaudunhaugen" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-3 bg-stone-100 rounded-xl text-stone-700 hover:bg-stone-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            Facebook
          </a>
          <a href="https://www.instagram.com/I_am_audun" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-3 bg-stone-100 rounded-xl text-stone-700 hover:bg-stone-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            Instagram
          </a>
        </div>

        <div class="mt-8 flex justify-center">
        <a href={`${base}kontakt`} class="inline-flex items-center gap-2 text-white px-6 py-3 rounded-full font-medium hover:opacity-85 transition-opacity" style="background-color: var(--accent)">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Ta kontakt
        </a>
      </div>
    </div>
  </section>
</Layout>
