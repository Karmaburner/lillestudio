---
import Layout from '../layouts/Layout.astro'
import { bildeMedId } from '../data/images'
import { bilde } from '../lib/bilde'
const base = import.meta.env.BASE_URL

const testimonials = [
  {
    name: 'Tonje Ø. Martinsen',
    text: 'Er superfornøyd med barnebildene og bryllupsbildene vi har fått!',
  },
  {
    name: 'Thea Karina Jakobsson',
    text: 'Fantastiske bilder av de tre barna våre, og et fantastisk håndlag med ungene under fotograferingen. 100% anbefalning fra oss her på Almemoen.',
  },
]

// Hero: hvert felt peker på en egen id i images.ts, ingen gjentakelser.
const hero = [
  { id: 'babykrybbe', klasse: 'relative h-[48vw] md:h-full md:row-span-2 overflow-hidden group cursor-pointer' },
  { id: 'parbilde-farger', klasse: 'relative h-[48vw] md:h-full overflow-hidden group cursor-pointer' },
  { id: 'konfirmanten', klasse: 'relative overflow-hidden group cursor-pointer hidden md:block' },
  { id: 'parbilder', klasse: 'relative overflow-hidden group cursor-pointer hidden md:block' },
  { id: 'babygitar', klasse: 'relative col-span-2 h-[40vw] md:col-span-1 md:h-full overflow-hidden group cursor-pointer' },
  { id: 'gronnbaby', klasse: 'relative overflow-hidden group cursor-pointer hidden md:block' },
  { id: 'harley', klasse: 'relative overflow-hidden group cursor-pointer hidden md:block' },
].map(felt => {
  const data = bildeMedId(felt.id)!
  return { ...felt, ...data, ...bilde(data.src) }
})

const kategorier = [
  { label: 'Barn & familie', id: 'familie' },
  { label: 'Konfirmant', id: 'konfirmanten' },
  { label: 'Bryllupsfoto', id: 'parbilder' },
  { label: 'Portrett', id: 'svarthvit' },
  { label: 'Babyfoto', id: 'babykrybbe' },
  { label: 'Bedrift & reklame', id: 'harley2' },
].map(k => ({ ...k, ...bilde(bildeMedId(k.id)!.src) }))

const mobiltStudio = bilde('/images/mobilt_studio_foto_i_ditt_hjem_bilde.webp')
---

<Layout
  heltittel="Fotograf Audun Haugen i Hønefoss | Lille Studio"
  description="Fotograf Audun Haugen i Hønefoss og Ringerike. Profesjonell familie-, portrett-, konfirmant- og bryllupsfotografering. Mobilt studio, vi kommer hjem til deg."
>
  <!-- Hero collage -->
  <section class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 md:h-[90vh] md:min-h-[560px] gap-1" aria-label="Utvalgte bilder">
    {hero.map(({ id, klasse, src, srcset, width, height, alt }, i) => (
      <button type="button" data-bilde={id} aria-label={`Åpne bildet: ${alt}`} class={`${klasse} focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-white`}>
        <img
          src={src}
          srcset={srcset}
          sizes="(min-width: 768px) 25vw, 50vw"
          width={width}
          height={height}
          alt={alt}
          loading={i < 2 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
      </button>
    ))}
  </section>

  <!-- Intro -->
  <section class="max-w-3xl mx-auto px-6 py-12 md:py-20 text-center">
    <h2 class="font-semibold mb-4">Øyeblikk som varer</h2>
    <p class="text-stone-500 text-lg leading-relaxed">
      Audun Haugen er en erfaren portrett- og familiefotograf med et kreativt blikk og et naturlig håndlag med folk i alle aldre. Enten det er babyfotografering, konfirmant eller bryllup: hvert bilde forteller din historie.
    </p>
    <div class="flex gap-4 justify-center mt-8 flex-wrap">
      <a href={`${base}galleri`} style="background-color: var(--accent)" class="text-white px-7 py-3 rounded-full font-medium transition-opacity hover:opacity-85 inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Se galleri
      </a>
      <a href={`${base}kontakt`} style="border-color: var(--accent); color: var(--accent)" class="border px-7 py-3 rounded-full font-medium transition-opacity hover:opacity-75 inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Ta kontakt
      </a>
    </div>
    <a href={`${base}om-meg`} class="inline-block mt-6 text-sm font-medium text-stone-500 underline underline-offset-4 hover:text-stone-700 transition-colors">
      Les mer om Audun
    </a>
  </section>

  <!-- Kategorier -->
  <section class="max-w-5xl mx-auto px-6 pb-12 md:pb-20">
    <h2 class="font-semibold text-center mb-10">Hva kan jeg hjelpe med?</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {kategorier.map(({ label, src, srcset, width, height }) => (
        <a href={`${base}galleri`} class="relative overflow-hidden rounded-lg aspect-square group">
          <img
            src={src}
            srcset={srcset}
            sizes="(min-width: 768px) 33vw, 50vw"
            width={width}
            height={height}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/50 transition-colors"></div>
          <span class="absolute bottom-3 left-3 text-white font-medium text-sm">{label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Mobilt studio -->
  <section class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="overflow-hidden rounded-2xl" style="background-color: #F7F3EE;">
        <img
          src={mobiltStudio.src}
          srcset={mobiltStudio.srcset}
          sizes="(min-width: 768px) 50vw, 100vw"
          width={mobiltStudio.width}
          height={mobiltStudio.height}
          alt="Mobilt fotostudio rigget opp i en stue"
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-contain"
        />
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-stone-500 mb-3">Der DU er</p>
        <h2 class="font-semibold mb-5">Studioet kommer hjem til deg</h2>
        <p class="text-stone-500 leading-relaxed mb-6">
          Audun har et komplett mobilt fotostudio og reiser hjem til deg. Du slipper å stresse med transport og fremmede omgivelser. Bildene tas der familien allerede er trygg.
        </p>
        <ul class="space-y-2 text-sm text-stone-600 mb-8">
          {['Profesjonelt utstyr på din adresse', 'Hele Ringerike og omegn', 'Rolige omgivelser for barn og baby', 'Fleksibel timeavtale'].map(item => (
            <li class="flex items-center gap-2">
              <span class="text-stone-500" aria-hidden="true">✓</span> {item}
            </li>
          ))}
        </ul>
        <a href={`${base}kontakt`} class="inline-flex items-center gap-2 text-white px-6 py-3 rounded-full text-sm font-medium hover:opacity-85 transition-opacity" style="background-color: var(--accent)">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Bestill hjemmebesøk
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-stone-900 py-14 md:py-24 px-6 overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <p class="text-center text-xs uppercase tracking-[0.2em] text-stone-400 mb-4">Fornøyde kunder</p>
      <h2 class="font-semibold text-center text-white mb-16">Hva sier kundene?</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 max-w-3xl mx-auto">
        {testimonials.map(({ name, text }) => (
          <figure class="bg-stone-800 rounded-xl p-6 md:p-8 flex flex-col justify-between border-l-4" style="border-color: var(--accent);">
            <div>
              <span class="block text-6xl leading-none mb-1" style="color: var(--accent); font-family: 'Cormorant Garamond', serif" aria-hidden="true">"</span>
              <blockquote class="text-stone-300 leading-relaxed text-lg italic" style="font-family: 'Cormorant Garamond', serif">{text}</blockquote>
            </div>
            <figcaption class="mt-6 text-xs uppercase tracking-widest text-stone-400">{name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 flex flex-col items-center justify-center px-6 text-center">
    <h2 class="font-semibold mb-4">Klar for en fotografering?</h2>
    <p class="text-stone-500 mb-8">Ta kontakt for å avtale time eller få et tilbud.</p>
    <a href={`${base}kontakt`} class="inline-flex items-center gap-2 text-white px-8 py-3 rounded-full font-medium hover:opacity-85 transition-opacity" style="background-color: var(--accent)">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Kontakt meg
    </a>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-bilde]').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.bilde
      if (id) (window as any).openLightbox(id)
    })
  })
</script>
